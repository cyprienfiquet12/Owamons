# Server
PORT=3000
NODE_ENV=production

# Database — avec Docker, ces valeurs sont utilisées par docker-compose
# (DATABASE_URL est construite automatiquement vers le conteneur postgres)
POSTGRES_USER=owamons
POSTGRES_PASSWORD=owamons
POSTGRES_DB=owamons

# Sans Docker : décommentez et adaptez
# DATABASE_URL=postgresql://owamons:owamons@localhost:5432/owamons

# Twitch (obligatoire pour le chat)
TWITCH_CHANNEL=your_channel_name
TWITCH_BOT_USERNAME=your_channel_name
TWITCH_ACCESS_TOKEN=oauth:your_token

# Webhooks (optionnel)
STREAMELEMENTS_WEBHOOK_SECRET=
WIZEBOT_WEBHOOK_SECRET=

# Spawn automatique (optionnel)
AUTO_SPAWN_ENABLED=true
AUTO_SPAWN_MIN_MINUTES=5
AUTO_SPAWN_MAX_MINUTES=15
AUTO_ARENA_SPAWN_ENABLED=true
AUTO_ARENA_SPAWN_MIN_MINUTES=45
AUTO_ARENA_SPAWN_MAX_MINUTES=180
